generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  username       String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  rating         UserRating?
  gameMember     GameMember[]
  questionAnswer QuestionAnswer[]
  receiver       Friends[]        @relation("receiver")
  sender         Friends[]        @relation("sender")
}

model Game {
  id         String           @id @default(uuid())
  timeLimit  Int              @default(60)
  startedAt  DateTime?
  endsAt     DateTime?
  winnerId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  status     GameStatus       @default(Searching_for_Player)
  gameMember GameMember[]
  question   Question[]
  answers    QuestionAnswer[]

  @@index([status])
  @@index([createdAt])
}

model GameMember {
  id        String            @id @default(uuid())
  gameId    String
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int               @default(0)
  status    GameMemberStatus?
  createdAt DateTime          @default(now())

  @@unique([gameId, userId])
  @@index([userId])
}

enum GameMemberStatus {
  WON
  LOSS
}

enum GameStatus {
  Running
  Searching_for_Player
  Ended
}

model UserRating {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(1000)
  updatedAt DateTime @updatedAt
}

model Friends {
  id         String        @id @default(uuid())
  status     FriendsStatus @default(pending)
  receiverId String
  senderId   String
  createdAt  DateTime      @default(now())
  receiver   Users         @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     Users         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

enum FriendsStatus {
  accepted
  rejected
  pending
}

model Question {
  id         String           @id @default(uuid())
  gameId     String
  game       Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  answers    QuestionAnswer[]
  operation1 Int
  operation2 Int
  sign       QuestionSign
  answer     Int
  position   Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([gameId])
}

model QuestionAnswer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Int
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId     String
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  correct    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@index([gameId])
  @@index([userId])
}

enum QuestionSign {
  PLUS
  MINUS
  MULTIPLICATION
  DIVIDE
}
